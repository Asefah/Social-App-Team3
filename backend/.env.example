# Option A: copy to backend/.env
# Option B: use repo-root .env (server loads ../.env first, then backend/.env overrides)
#
# PostgreSQL must be RUNNING (not just the psql client).
# macOS: brew install postgresql@16 && brew services start postgresql@16
# Check connection:  npm run db:ping --prefix backend
#
# If you installed libpq only, psql lives here until you add PATH:
#   export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Required. If "postgres" login fails, use your macOS username (same as `whoami`).
# Create the database: npm run db:create --prefix backend
DB_USER=postgres
DB_HOST=localhost
DB_NAME=umassconnect
DB_PASSWORD=
DB_PORT=5432

JWT_SECRET=change-this-to-a-long-random-string

PORT=3000

# Optional absolute origin for links returned after image upload (e.g. https://api.yourdomain.com).
# If unset, the Host header from the incoming request is used (fine for local dev on the same machine).
# PUBLIC_BASE_URL=
